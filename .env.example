# Supabase — required for production (auth + persistent data)
# Without these, the app runs in local mock/demo mode only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — admin writes (events, fights, grading). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed to access /admin when Supabase is connected
ADMIN_EMAILS=you@example.com

# Local dev only: set true to use live Supabase instead of mock demo data (fightfan42).
# Production always uses Supabase when env vars above are set.
# PICKFIST_USE_SUPABASE=true

# Local dev only: show phantom test card from .mock-data/phantom-picks-card.json (gitignored).
# PICKFIST_PHANTOM_CARD=true

# Bootstrap leaderboards — production: set PICKFIST_SEED_RANKINGS=true on Vercel.
# Local mock dev enables seeds automatically when this var is unset (omit it).
# Set PICKFIST_SEED_RANKINGS=false locally to disable bootstrap seeds.
# Change on Vercel requires a redeploy.
# PICKFIST_SEED_RANKINGS=true
PICKFIST_SEED_RANKINGS_TARGET=10

# Stripe billing (production) — required for /subscribe Checkout + webhooks
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_1TiTIpEZO2o1qInth1mLchpr
STRIPE_WEBHOOK_SECRET=whsec_...
# Public site URL for Checkout return URLs (e.g. https://pickfist.com)
NEXT_PUBLIC_APP_URL=https://pickfist.com
# Optional display label on /subscribe
# PICKFIST_SUBSCRIPTION_PRICE_LABEL=$1.99/month
